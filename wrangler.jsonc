{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garfield",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "deb3f265-a9c1-4a16-a10a-32444458a3d1","database_name": "garfield" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "039f7ef441f64e4d81ba1391d7753b2d" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
